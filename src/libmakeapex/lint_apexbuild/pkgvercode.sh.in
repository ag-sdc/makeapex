[[ -n "$LIBMAKEAPEX_LINT_APEXBUILD_PKGVERCODE_SH" ]] && return
LIBMAKEAPEX_LINT_APEXBUILD_PKGVERCODE_SH=1

MAKEAPEX_LIBRARY=${MAKEAPEX_LIBRARY:-"@libmakeapexdir@"}

source "$MAKEAPEX_LIBRARY/util/message.sh"
source "$MAKEAPEX_LIBRARY/util/apexbuild.sh"

lint_apexbuild_functions+=('lint_pkgvercode')

check_pkgvercode() {
	local val=$1 type=$2

	if [[ -n $val && $val != +([0-9]) ]]; then
		error "$(gettext "%s must be a positive integer, not %s.")" "pkgvercode${type:+ in $type}" "$val"
		return 1
	fi
}

lint_pkgvercode() {
	local ret=0 out pkg

	check_pkgvercode "$pkgvercode" || ret=1

	for pkg in "${pkgname[@]}"; do
		if extract_function_variable "package_$pkg" pkgvercode 0 out; then
			check_pkgvercode "$out" "package_$pkg" || ret=1
		fi
	done

	return $ret
}
