CARCH="x86_64"
CHOST="x86_64-pc-linux-gnu"
PKGEXT=".apex"
SRCEXT=".src.tar.gz"

# Compress APEX format into .capex
compress_apex="false"

# Build environment options
BUILDENV=(color check !sign)

# Packaging options (strip binaries/libraries by default; keep libtool and staticlibs for extractive/-dev APEXes)
OPTIONS=(strip docs libtool staticlibs emptydirs zipman purge !debug !lto !autodeps)

# Strip flags used when 'strip' is enabled in OPTIONS
STRIP_BINARIES="--strip-all"
STRIP_SHARED="--strip-unneeded"
STRIP_STATIC="--strip-debug"

#
# Privilege escalation command
#
PACMAN_AUTH=(sudo)
